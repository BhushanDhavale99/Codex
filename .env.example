# ==============================================================================
# BrandOS AI — Environment Configuration Template
# Copy this file to .env and supply your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Node / Express Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Recommended Model: gemini-3.8-flash (fast, high precision structured outputs)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# Create project at https://supabase.com/
# Run SQL migrations located in server/db/migrations/
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=brand-guidelines

# ------------------------------------------------------------------------------
# 3. Development Mode & Isolated Fallback
# When true in development, if credentials are missing the server starts in safe
# development mode with pure business logic & local PDF extraction.
# Set to false to strictly enforce external credentials.
# ------------------------------------------------------------------------------
ALLOW_DEV_FALLBACK=true

# ------------------------------------------------------------------------------
# 4. Frontend Integration
# Used by Vite client to connect to this Express REST API
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_USE_MOCK=false
